@FoodOrdering.Api_HostAddress = http://localhost:5230

### 1. Login as the seeded Platform Admin
# @name adminLogin
POST {{FoodOrdering.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@foodordering.local",
  "password": "AdminPassword123"
}

### 2. Admin creates a store and assigns/creates its Store Owner
POST {{FoodOrdering.Api_HostAddress}}/api/stores
Content-Type: application/json
Authorization: Bearer {{adminLogin.response.body.accessToken}}

{
  "slug": "taco-town",
  "name": "Taco Town",
  "email": "hello@tacotown.local",
  "phone": "+1-555-0104",
  "ownerEmail": "owner@tacotown.local",
  "ownerFullName": "Taco Owner",
  "ownerPassword": "Password123"
}

### 3. Store Owner logs in (managedStores will include taco-town as Owner = 3)
# @name ownerLogin
POST {{FoodOrdering.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "owner@tacotown.local",
  "password": "Password123"
}

### 4. Store Owner adds a Staff member to Taco Town (Role: 1=Staff, 2=Manager, 3=Owner)
POST {{FoodOrdering.Api_HostAddress}}/api/store-members
Content-Type: application/json
Authorization: Bearer {{ownerLogin.response.body.accessToken}}
X-Store-Slug: taco-town

{
  "email": "staff@tacotown.local",
  "role": 1,
  "fullName": "Taco Staff",
  "password": "Password123"
}

### 5. List Taco Town members (Manager/Owner only)
GET {{FoodOrdering.Api_HostAddress}}/api/store-members
Accept: application/json
Authorization: Bearer {{ownerLogin.response.body.accessToken}}
X-Store-Slug: taco-town

### 6. Staff logs in and creates a category for Taco Town
# @name staffLogin
POST {{FoodOrdering.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "staff@tacotown.local",
  "password": "Password123"
}

### 7. Staff creates a category for Taco Town (returns 201 Created)
# @name createCategory
POST {{FoodOrdering.Api_HostAddress}}/api/categories
Content-Type: application/json
Authorization: Bearer {{staffLogin.response.body.accessToken}}
X-Store-Slug: taco-town

{
  "name": "Street Tacos",
  "sortOrder": 1
}

### 7b. Staff adds a MenuItem under that category
# @name createMenuItem
POST {{FoodOrdering.Api_HostAddress}}/api/menu-items
Content-Type: application/json
Authorization: Bearer {{staffLogin.response.body.accessToken}}
X-Store-Slug: taco-town

{
  "categoryPublicId": "{{createCategory.response.body.publicId}}",
  "name": "Carne Asada Taco",
  "description": "Grilled steak, cilantro, onion, lime",
  "price": 4.50,
  "isAvailable": true,
  "sortOrder": 1
}

### 8. Customer registers publicly (gets global Customer role, no store_members access)
# @name customerLogin
POST {{FoodOrdering.Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "fullName": "Jane Customer",
  "email": "jane@example.com",
  "password": "Password123"
}

### 9. Check current user profile & managed stores
GET {{FoodOrdering.Api_HostAddress}}/api/auth/me
Authorization: Bearer {{ownerLogin.response.body.accessToken}}
Accept: application/json

### 10. Public store & category browsing (no auth required)
GET {{FoodOrdering.Api_HostAddress}}/api/stores
Accept: application/json

###
GET {{FoodOrdering.Api_HostAddress}}/api/categories
Accept: application/json
X-Store-Slug: taco-town

###
GET {{FoodOrdering.Api_HostAddress}}/api/menu-items?availableOnly=true
Accept: application/json
X-Store-Slug: taco-town

### 11. Customer places an order at Taco Town (server computes total & snapshots price)
# @name placeOrder
POST {{FoodOrdering.Api_HostAddress}}/api/orders
Content-Type: application/json
Authorization: Bearer {{customerLogin.response.body.accessToken}}
X-Store-Slug: taco-town

{
  "items": [
    {
      "menuItemPublicId": "{{createMenuItem.response.body.publicId}}",
      "quantity": 2
    }
  ],
  "notes": "Extra lime please"
}

### 12. Customer views their own order history
GET {{FoodOrdering.Api_HostAddress}}/api/orders/my
Accept: application/json
Authorization: Bearer {{customerLogin.response.body.accessToken}}

### 13. Store Staff views incoming orders for Taco Town
GET {{FoodOrdering.Api_HostAddress}}/api/orders
Accept: application/json
Authorization: Bearer {{staffLogin.response.body.accessToken}}
X-Store-Slug: taco-town

### 14. Store Staff confirms the order (Status: 2=Confirmed, 3=Preparing, 4=Ready, 5=Completed, 6=Cancelled)
PATCH {{FoodOrdering.Api_HostAddress}}/api/orders/{{placeOrder.response.body.publicId}}/status
Content-Type: application/json
Authorization: Bearer {{staffLogin.response.body.accessToken}}
X-Store-Slug: taco-town

{
  "status": 2
}
